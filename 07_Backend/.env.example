# Copy values into your existing 07_Backend/.env (never commit .env).
# Existing variables (FIREBASE_DATABASE_URL, PORT, ...) are unchanged.

# --- Blockchain integrity layer (optional) ---------------------------------
# Leave these three unset to run the backend without blockchain features.

# JSON-RPC endpoint of the chain. Local Hardhat node, or Polygon Amoy testnet.
#   local:  http://127.0.0.1:8545
#   amoy:   https://polygon-amoy.drpc.org
BLOCKCHAIN_RPC_URL=

# Private key of the backend's signing wallet (a TEST wallet with test funds only).
# Must be an authorised writer on the contract (the deployer is by default). 0x-prefixed.
BLOCKCHAIN_PRIVATE_KEY=

# Address printed by the deploy script.
BLOCKCHAIN_CONTRACT_ADDRESS=

# Recommended: chain ID (31337 for a local Hardhat node, 80002 for Polygon Amoy).
BLOCKCHAIN_CHAIN_ID=

# Optional: transaction URL prefix used to build explorer links in the UI.
#   amoy: https://amoy.polygonscan.com/tx
BLOCKCHAIN_EXPLORER_TX_URL=

# Optional: only if Amoy rejects transactions with "gas tip cap below minimum".
# BLOCKCHAIN_MIN_PRIORITY_FEE_GWEI=30
