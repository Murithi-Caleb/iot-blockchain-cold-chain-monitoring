# Copy to .env (or .env.local) and adjust. Neither value is a secret.

# Base URL of the Express backend (default: http://localhost:5000)
VITE_API_BASE_URL=http://localhost:5000

# Address encoded in printed QR labels. A phone scanning a label must be able to open it,
# so for demos on a local network use this machine's LAN address, e.g. http://192.168.1.20:5173
# Defaults to the address the app is currently opened from.
VITE_PUBLIC_BASE_URL=
