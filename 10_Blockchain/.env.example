# Copy to .env (never commit .env). Used only for deploying to Polygon Amoy.

# RPC endpoint for Polygon Amoy (chain ID 80002). Any provider works.
AMOY_RPC_URL=https://polygon-amoy.drpc.org

# Private key of a THROWAWAY test wallet funded with test POL. Must start with 0x.
# Never use a wallet that holds real funds.
DEPLOYER_PRIVATE_KEY=

# Optional: PUBLIC address of the wallet the backend will sign with, if different from
# the deployer. The deploy script authorises it as a writer.
BACKEND_WRITER_ADDRESS=
